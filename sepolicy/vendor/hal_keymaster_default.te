# Lenovo keystore.msm8953.so talks to the keymaster trustlet via QSEECom
allow hal_keymaster_default tee_device:chr_file rw_file_perms;
allow hal_keymaster_default firmware_file:dir r_dir_perms;
allow hal_keymaster_default firmware_file:file r_file_perms;
get_prop(hal_keymaster_default, vendor_tee_listener_prop)
