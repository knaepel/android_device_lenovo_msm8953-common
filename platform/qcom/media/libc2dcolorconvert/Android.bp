cc_library_shared {
    name: "libc2dcolorconvert",
    vendor: true,

    srcs: [
        "C2DColorConverter.cpp",
    ],

    cflags: [
        // flags soong applies to hardware/qcom-caf (third-party path)
        "-fcommon",
        "-Wno-format-insufficient-args",
        "-Wno-misleading-indentation",
        "-Wno-unused",
        "-Wno-unused-parameter",
        "-Wno-unused-but-set-parameter",
        "-Wno-unused-variable",
        "-Wno-unqualified-std-cast-call",
        "-Wno-array-parameter",
        "-Wno-gnu-offsetof-extensions",
        "-Wno-pessimizing-move",
        "-Wno-pointer-to-int-cast",
        "-Werror",
    ],

    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libdl",
        "liblog",
    ],
}

cc_library_headers {
    name: "libc2dcolorconvert_headers",
    export_include_dirs: ["."],
    vendor: true,
}
