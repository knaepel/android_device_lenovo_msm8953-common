cc_library_static {
    name: "libOmxVidcCommon",
    vendor: true,

    srcs: [
        "src/extra_data_handler.cpp",
        "src/vidc_color_converter.cpp",
        "src/vidc_vendor_extensions.cpp"
    ],

    cflags: [
        // flags soong applies to hardware/qcom-caf (third-party path)
        "-fcommon",
        "-Wno-format-insufficient-args",
        "-Wno-misleading-indentation",
        "-Wno-unused",
        "-Wno-unused-parameter",
        "-Wno-unused-but-set-parameter",
        "-Wno-unused-variable",
        "-Wno-unqualified-std-cast-call",
        "-Wno-array-parameter",
        "-Wno-gnu-offsetof-extensions",
        "-Wno-pessimizing-move",
        "-Wno-pointer-to-int-cast",
        "-Werror",
        "-D_ANDROID_",
        "-D_ANDROID_ICS_",
    ],

    header_libs: [
        "display_headers",
        "libc2dcolorconvert_headers",
        "libomxcommon_headers",
        "libomxcore_headers",
        "libutils_headers",
        "qti_kernel_headers",
    ],
}

cc_library_headers {
    name: "libomxcommon_headers",
    export_include_dirs: ["inc"],
    vendor: true,
}
